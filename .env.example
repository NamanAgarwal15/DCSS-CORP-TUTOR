# Google AI Studio API key for Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Postgres connection string (e.g. Neon). Use the DIRECT (non-pooled) Neon
# string so `prisma migrate deploy` works during the build.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# News update mode: "grounded" = live Google Search grounding (requires a key
# tier with grounding quota); "manual" = student pastes news text, Gemini parses
# it. Defaults to "manual" in code if unset.
NEWS_MODE="manual"

# Faculty login for /faculty (compared in constant time; never stored in the DB)
FACULTY_USERNAME=choose_a_username
FACULTY_PASSWORD=choose_a_long_password

# Secret used to sign login cookies. At least 16 characters; use a long random
# value, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_long_random_string
